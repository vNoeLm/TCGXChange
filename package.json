    "@types/react-dom": "^19.2.4",
    "astro": "^7.1.6",
    "dotenv": "^17.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.151.1"
