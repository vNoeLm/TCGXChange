---
// Fonts are served from this site (Fontsource), not Google Fonts: no request to another server
// before the page can render, and visitors' browsers don't contact Google.
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { Navigation } from '../components/Navigation';
import { GameSelector } from '../components/GameSelector';
import { LegalFooter } from '../components/LegalFooter';
import { BackToTop } from '../components/BackToTop';
import { CookieConsent } from '../components/CookieConsent';
import { AccountAccessGate } from '../components/AccountAccessGate';
import { MarketplaceCartDrawer } from '../components/marketplace/MarketplaceCartDrawer';
import { TcgLogo } from '../components/TcgLogo';

interface Props {
  title: string;
}

const { title } = Astro.props;
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!-- Body/UI: Inter. Headings: Space Grotesk - gives titles and card names some personality
         without touching the numbers, labels and buttons that need to stay purely legible. -->
    <!-- The text font, fetched straight away rather than once the styles have been read. -->
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin>
    <!-- Immediate theme resolution to prevent FOUC -->
    <script is:inline>
      (function() {
        // Global error tracking to catch hydration errors and runtime exceptions
        var sendError = function(payload) {
          try {
            fetch('/api/client-error', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            }).catch(function() {});
          } catch (_) {}
        };
        window.addEventListener('error', function(e) {
          sendError({
            type: 'window.error',
            message: e.message,
            filename: e.filename,
            lineno: e.lineno,
            colno: e.colno,
            stack: e.error ? (e.error.stack || e.error.message) : null,
            url: window.location.href
          });
        });
        window.addEventListener('unhandledrejection', function(e) {
          sendError({
            type: 'unhandledrejection',
            reason: e.reason ? (e.reason.stack || e.reason.message || String(e.reason)) : null,
            url: window.location.href
          });
        });
        var origConsoleError = console.error;
        console.error = function() {
          origConsoleError.apply(console, arguments);
          try {
            var msg = Array.prototype.slice.call(arguments).map(function(a) {
              return a instanceof Error ? (a.stack || a.message) : (typeof a === 'object' ? JSON.stringify(a) : String(a));
            }).join(' ');
            sendError({
              type: 'console.error',
              message: msg,
              url: window.location.href
            });
          } catch (_) {}
        };

        try {
          var override = localStorage.getItem('tcg_theme_override');
          // Cyberpunk TCG was removed: a browser still set to it switches back to Riftbound here,
          // before any part of the page reads the active game or saved catalog filters.
          if (localStorage.getItem('tcg_active_game') === 'cyberpunk') localStorage.setItem('tcg_active_game', 'riftbound');
          try {
            ['catalogFilters', 'catalogGame', 'inventoryFilters'].forEach(function (k) {
              var v = sessionStorage.getItem(k);
              if (v && v.indexOf('cyberpunk') !== -1) sessionStorage.removeItem(k);
            });
          } catch (e) {}
          // The old themes fall back to the defaults (Midnight Slate / Ivory Parchment)
          if (override === 'cyberpunk' || override === 'riftbound') { localStorage.removeItem('tcg_theme_override'); override = null; }
          if (override === 'custom') {
            document.documentElement.setAttribute('data-theme', 'custom');
            try {
              var customRaw = localStorage.getItem('tcg_custom_theme');
              if (customRaw) {
                var c = JSON.parse(customRaw);
                var root = document.documentElement;
                if (c.bgPage) root.style.setProperty('--custom-bg-page', c.bgPage);
                if (c.bgSurface) root.style.setProperty('--custom-bg-surface', c.bgSurface);
                if (c.bgSurface2) root.style.setProperty('--custom-bg-surface-2', c.bgSurface2);
                if (c.accent) root.style.setProperty('--custom-accent', c.accent);
                if (c.accentSecondary) root.style.setProperty('--custom-accent-secondary', c.accentSecondary);
                if (c.textPrimary) root.style.setProperty('--custom-text-primary', c.textPrimary);
                if (c.textMuted) root.style.setProperty('--custom-text-muted', c.textMuted);
                if (c.border) root.style.setProperty('--custom-border', c.border);
                if (c.borderRadius !== undefined) root.style.setProperty('--custom-radius', c.borderRadius + 'px');
                if (c.glowIntensity !== undefined) {
                  var gf = c.glowIntensity / 50;
                  root.style.setProperty('--custom-glow', String(c.glowIntensity));
                  root.style.setProperty('--custom-glow-pct', Math.round(28 * gf) + '%');
                  root.style.setProperty('--custom-shadow-glow', Math.round(16 * gf) + 'px');
                }
              }
            } catch (e) {}
          } else {
            var theme = (override === 'dark' || override === 'light')
              ? override
              : (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
            document.documentElement.setAttribute('data-theme', theme);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col font-sans">
    <header style="border-bottom: 1px solid var(--border); background: var(--bg-header); backdrop-filter: blur(16px);" class="sticky top-0 z-50 transition-colors duration-200">
      <div style="max-width: 1400px; margin: 0 auto; padding: 10px clamp(12px, 2.5vw, 24px);" class="flex flex-nowrap justify-between items-center gap-2 sm:gap-3 xl:gap-4">
        <div class="flex items-center gap-2 sm:gap-3 xl:gap-3.5 shrink-0 min-w-0">
          <a href="/" class="flex items-center gap-1.5 sm:gap-2.5 group transition shrink-0" style="text-decoration: none;">
            <TcgLogo className="w-7 h-7 sm:w-8 sm:h-8 shrink-0 transition-transform group-hover:scale-105" client:load />
            <span class="inline-flex items-baseline text-sm sm:text-base xl:text-xl font-black tracking-tight whitespace-nowrap text-[var(--text-primary)] group-hover:text-[var(--text-accent)] transition-colors" style="font-family: var(--font-display);">
              TCG XChange<span class="text-[#f97316] font-bold text-xs sm:text-sm tracking-normal ml-0.5">.net</span>
            </span>
          </a>
          <div class="h-4 sm:h-5 w-px bg-[var(--border)] opacity-60 shrink-0" />
          <div class="min-w-0">
            <GameSelector disabled={pathname.startsWith('/store')} client:load />
          </div>
        </div>
        <div class="flex items-center gap-1.5 sm:gap-2.5 xl:gap-3 shrink-0">
          <Navigation currentPath={pathname} client:load />
        </div>
      </div>
    </header>
    <AccountAccessGate currentPath={pathname} client:load />
    <!-- Takes the leftover height so the footer sits at the bottom of short pages. A plain block
         wrapper rather than making each page a flex item: pages center themselves with
         `margin: 0 auto` + max-width, which inside a flex column shrinks them to their content. -->
    <div class="flex-1 w-full">
      <slot />
    </div>
    <MarketplaceCartDrawer client:load />
    <LegalFooter client:load />
    <BackToTop client:load />
    <CookieConsent client:load />
    <script is:inline>
      // Publishes the sticky header's real height as --header-h (see --page-chrome-h in global.css).
      (function () {
        var header = document.querySelector('header');
        if (!header || !window.ResizeObserver) return;
        var publish = function () {
          document.documentElement.style.setProperty('--header-h', header.getBoundingClientRect().height + 'px');
        };
        publish();
        new ResizeObserver(publish).observe(header);
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --font-inter: 'Inter Variable', 'Inter', system-ui, sans-serif;
    --font-display: 'Space Grotesk Variable', 'Space Grotesk', var(--font-inter);
  }
  body {
    font-family: var(--font-inter);
  }
  /* Titles get the display font; numbers, labels, badges and buttons stay in Inter for pure
     legibility - drawing the line at real heading tags keeps this from spreading everywhere. */
  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-display);
  }
</style>
