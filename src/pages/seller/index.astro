---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Store | TCG XChange">
  <div class="max-w-xl mx-auto px-4 py-16 text-center">
    <div class="p-8 rounded-2xl border shadow-sm" style="background: var(--bg-surface); border-color: var(--border);">
      <h1 class="text-xl font-black mb-2" style="color: var(--text-primary);">
        Seller Hub Has Been Sunset
      </h1>
      <p class="text-xs mb-6" style="color: var(--text-secondary);">
        Single cards are now managed and sold directly through the Store.
      </p>
      <a
        href="/store?category=singles"
        class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-xs font-black transition hover:brightness-110"
        style="background: var(--accent-strong); color: var(--text-on-accent, #000);"
      >
        <span>Go to Store</span>
        <span>→</span>
      </a>
    </div>
  </div>
  <script is:inline>
    window.location.replace('/store?category=singles');
  </script>
</Layout>
