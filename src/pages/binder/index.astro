---
import Layout from '../../layouts/Layout.astro';
import { BinderApp } from '../../components/binder/BinderApp';
import { SITE_URL, buildBreadcrumbJsonLd } from '../../lib/seo';

const binderSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'TCG XChange Binder Map',
    applicationCategory: 'UtilityApplication',
    operatingSystem: 'All',
    url: `${SITE_URL}/binder`,
    description: 'Plan physical 3x3 and 4x3 collector binders and track missing cards across sets on TCG XChange.',
  },
  buildBreadcrumbJsonLd([
    { name: 'Catalog', url: '/' },
    { name: 'Binder Map', url: '/binder' },
  ]),
];
---

<Layout
  title="Binder Map | TCG XChange"
  description="Plan physical 3x3 and 4x3 collector binders and track missing cards across sets on TCG XChange."
  structuredData={binderSchema}
>
  <BinderApp client:load />
</Layout>
