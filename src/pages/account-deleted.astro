---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Account deleted | TCG XChange">
  <div style="max-width: 640px; margin: 0 auto; padding: clamp(32px,6vw,80px) clamp(16px,3vw,24px);">
    <div class="rounded-2xl border p-6 sm:p-8 text-center" style="background: var(--bg-surface); border-color: var(--border);">
      <div
        class="w-14 h-14 rounded-2xl flex items-center justify-center mx-auto mb-5 border"
        style="background: var(--positive-muted); border-color: var(--positive-border); color: var(--positive);"
      >
        <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 6L9 17l-5-5" />
        </svg>
      </div>
      <h1 class="text-2xl font-black mb-2" style="color: var(--text-primary);">Your account has been deleted</h1>
      <p class="text-sm leading-relaxed mb-2" style="color: var(--text-secondary);">
        Your profile, listings, collections, wishlists, decks, messages and reviews are gone, and you have been signed out.
      </p>
      <p class="text-xs leading-relaxed mb-6" style="color: var(--text-tertiary);">
        Finished store orders are kept for accounting without your name or delivery details. You can create a new account at any time.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-2">
        <a
          href="/"
          class="px-4 py-2.5 rounded-xl text-xs font-black border transition hover:brightness-110"
          style="background: var(--accent-strong); border-color: var(--accent); color: var(--text-on-accent, #000);"
        >
          Browse the catalog
        </a>
        <a
          href="/register"
          class="px-4 py-2.5 rounded-xl text-xs font-bold border transition hover:brightness-110"
          style="background: var(--bg-raised); border-color: var(--border); color: var(--text-secondary);"
        >
          Create a new account
        </a>
      </div>
    </div>
  </div>
</Layout>
