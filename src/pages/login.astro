---
import Layout from '../layouts/Layout.astro';
import { AuthModal } from '../components/auth/AuthModal';
---

<Layout
  title="Sign In | TCG XChange"
  description="Sign in to your TCG XChange account to sync your card collection, wishlists, and decks across devices."
  noindex={true}
>
  <div style="min-height: calc(100dvh - 120px); width: 100%; display: flex; align-items: center; justify-content: center; padding: 40px 20px; box-sizing: border-box;">
    <AuthModal client:load isStandalone={true} initialMode="signin" />
  </div>
</Layout>
