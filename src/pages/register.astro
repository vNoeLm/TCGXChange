---
import Layout from '../layouts/Layout.astro';
import { AuthModal } from '../components/auth/AuthModal';
---

<Layout
  title="Create Account | TCG XChange"
  description="Create a free TCG XChange account to track your trading card collection and build decks."
  noindex={true}
>
  <div style="min-height: calc(100dvh - 120px); width: 100%; display: flex; align-items: center; justify-content: center; padding: 40px 20px; box-sizing: border-box;">
    <AuthModal client:load isStandalone={true} initialMode="signup" />
  </div>
</Layout>
