---
import Layout from '../../../layouts/Layout.astro';
import { ProfileApp } from '../../../components/profile/ProfileApp';
import { VALID_PROFILE_TABS, type ProfileTab } from '../../../lib/profileUrl';
import { buildProfileSeoMeta } from '../../../lib/seo';
import { fetchPublicProfileSeoData } from '../../../lib/seoServer';

export const prerender = false;
const { id, tab } = Astro.params;

const resolvedTab = tab && (VALID_PROFILE_TABS as readonly string[]).includes(tab.toLowerCase())
  ? (tab.toLowerCase() as ProfileTab)
  : undefined;

const profile = id ? await fetchPublicProfileSeoData(id) : null;
const seo = profile ? buildProfileSeoMeta(profile, resolvedTab) : null;
---

{seo ? (
  <Layout
    title={seo.title}
    description={seo.description}
    canonical={seo.canonical}
    noindex={seo.noindex}
    ogType={seo.ogType}
    ogImage={seo.ogImage}
    ogImageAlt={seo.ogImageAlt}
    structuredData={seo.jsonLd}
  >
    <ProfileApp client:load initialId={id} initialTab={resolvedTab} />
  </Layout>
) : (
  <Layout
    title="Profile | TCG XChange"
    description="View collector profiles, public card collections, and shared decks on TCG XChange."
    noindex={true}
  >
    <ProfileApp client:load initialId={id} initialTab={resolvedTab} />
  </Layout>
)}
