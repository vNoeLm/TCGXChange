---
import Layout from '../../layouts/Layout.astro';
import { ProfileApp } from '../../components/profile/ProfileApp';
---

<Layout title="Profile | TCG XChange">
  <script is:inline>
    // Seamlessly canonicalize /user?id=... to /profile?id=...
    const search = window.location.search;
    if (search) {
      window.location.replace('/profile' + search);
    }
  </script>
  <ProfileApp client:load />
</Layout>
